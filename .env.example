# Configuración del servidor
PORT=3000
NODE_ENV=development

# Base de datos MongoDB
MONGODB_URI=mongodb://localhost:27017/calima-online

# JWT Secret (cambia esto en producción con una cadena aleatoria segura)
JWT_SECRET=tu_secreto_jwt_muy_seguro_cambialo_en_produccion
JWT_EXPIRES_IN=7d

# CORS (puedes usar múltiples orígenes separados por comas)
CORS_ORIGIN=http://localhost:8080,https://calimaonline.vercel.app,https://www.calimaonline.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Steam API (para futuro)
STEAM_API_KEY=
STEAM_APP_ID=